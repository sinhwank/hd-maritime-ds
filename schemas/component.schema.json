{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "HD-MDS component spec",
  "type": "object",
  "required": ["id", "layer", "status", "origin", "description", "props", "theming"],
  "additionalProperties": false,
  "properties": {
    "id": { "type": "string", "pattern": "^[a-z][a-z0-9-]*$" },
    "name": { "type": "string" },
    "layer": { "enum": ["core", "maritime"] },
    "status": { "enum": ["draft", "review", "approved", "deprecated"] },
    "origin": {
      "type": "object",
      "required": ["decision"],
      "additionalProperties": false,
      "properties": {
        "decision": { "enum": ["adopt", "adapt", "extend", "hd-new"], "description": "adopt 그대로 | adapt OB 컴포넌트 수정 | extend OB 컴포넌트에 variant/속성 추가 | hd-new 신규" },
        "page": { "type": "string", "description": "Library 페이지 (예: 07 Automation)" },
        "set": { "type": "string", "description": "OB 컴포넌트 세트 이름 (예: Valve two-way)" },
        "notes": { "type": "string" }
      }
    },
    "description": { "type": "string" },
    "refs": { "type": "array", "items": { "type": "string" } },
    "anatomy": { "type": "array", "items": { "type": "string" } },
    "baseline": {
      "type": "object",
      "description": "OpenBridge 원본의 속성 (Figma에서 읽은 그대로, 비교 기준)",
      "additionalProperties": { "type": ["array", "object", "string"] }
    },
    "props": {
      "type": "object",
      "description": "HD 목표 속성. 테마·크기는 Variable mode로 처리하므로 넣지 않는다.",
      "not": { "anyOf": [{ "required": ["theme"] }, { "required": ["Theme"] }, { "required": ["size-mode"] }] },
      "additionalProperties": {
        "oneOf": [
          { "type": "array", "items": { "type": "string" }, "minItems": 1 },
          { "type": "object", "required": ["type"], "properties": { "type": { "enum": ["boolean", "text", "instance-swap"] }, "default": {} } }
        ]
      }
    },
    "changes": { "type": "array", "items": { "type": "string" }, "description": "baseline 대비 HD 변경 사항 (사람이 읽는 목록)" },
    "excludeCombinations": { "type": "array", "items": { "type": "object" } },
    "theming": { "const": "variables" },
    "tokens": { "type": "object", "additionalProperties": { "type": "string" }, "description": "부위 → OB 변수 이름" },
    "rules": { "type": "array", "items": { "type": "string" } },
    "dos": { "type": "array", "items": { "type": "string" } },
    "donts": { "type": "array", "items": { "type": "string" } }
  }
}
